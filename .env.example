NODE_ENV=development
PORT=4000

# MongoDB connection string. Must point at a replica set — checkout creates
# orders inside a transaction, which a standalone MongoDB server can't do.
# Local: mongodb://127.0.0.1:27017/express_ecommerce?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/express_ecommerce?retryWrites=true&w=majority
MONGO_URI=

# Generate each with: openssl rand -hex 32
# Must differ from each other and be at least 32 characters long.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=express-ecommerce-api
JWT_AUDIENCE=express-ecommerce-client

# Comma-separated list of allowed origins. Must be explicit (not "*") when
# NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Generate with: openssl rand -hex 24
COOKIE_SECRET=

LOG_LEVEL=info

# Optional — only needed for Stripe-method checkout/webhooks. COD checkout
# works fine with these unset (see src/config/stripe.js). See README.md's
# Stripe section for the full setup walkthrough.
#
# Create a restricted key (Dashboard -> Developers -> API keys -> Create
# restricted key) scoped to just "Checkout Sessions: Write" rather than
# using the full secret key.
STRIPE_SECRET_KEY=
# Signing secret for whichever webhook source you're using: `stripe listen`
# prints its own secret for local dev, while a Dashboard webhook endpoint
# has a different one for a deployed instance — they are not interchangeable.
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel
