# --- Server ---
NODE_ENV=development
# Port the HTTP server listens on.
PORT=4000

# --- Database ---
# MongoDB connection string. Checkout uses transactions, so MongoDB must run
# as a replica set (a single-node replica set is sufficient for local development).
MONGO_URI=mongodb://127.0.0.1:27017/express_ecommerce

# --- Auth (JWT) ---
# Secrets used to sign/verify JWTs. Must be at least 32 random characters each,
# and different from one another. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-secret
JWT_REFRESH_SECRET=change-me-to-a-different-32-char-secret
# How long an access token stays valid before the client must refresh it.
JWT_ACCESS_EXPIRES_IN=15m
# How long a refresh token (the httpOnly cookie) stays valid before re-login is required.
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=express-ecommerce-api
JWT_AUDIENCE=express-ecommerce-client

# --- CORS ---
# Comma-separated exact browser origins. Wildcards are rejected in production.
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
# Time window (ms) and max requests per IP within that window, applied to all /api routes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Cookies ---
# Secret used to sign cookies (cookie-parser). Generate with: openssl rand -hex 24
COOKIE_SECRET=dev-cookie-secret

# --- Logging ---
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
