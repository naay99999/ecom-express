{
  "name": "express-ecommerce-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "nodemon --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_MONGODB_INTEGRATION=true vitest run src/modules/orders/order.integration.test.js",
    "migrate:price-amount": "node --env-file=.env scripts/migrate-product-price-to-amount.js",
    "migrate:product-variants": "node --env-file=.env scripts/migrate-products-to-variants.js"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.17",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "mongoose": "^9.9.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
